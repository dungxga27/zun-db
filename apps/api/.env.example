NODE_ENV=development
PORT=3001
METADATA_MONGODB_URI=mongodb://127.0.0.1:27017/zun_metadata
MONGO_ADMIN_URI=mongodb://admin:change-me@127.0.0.1:27017/admin
# Host embedded in per-project URIs. Keep localhost unless direct access is secured and exposed.
PROJECT_MONGODB_HOST=127.0.0.1
PROJECT_MONGODB_PORT=27017
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
BACKUP_DIR=./data/backups
MONGODUMP_BIN=mongodump
MONGORESTORE_BIN=mongorestore
# JSON arrays; executable plus fixed arguments. Leave unset to disable service control.
MONGO_START_COMMAND=["systemctl","start","mongod"]
MONGO_STOP_COMMAND=["systemctl","stop","mongod"]
MONGO_RESTART_COMMAND=["systemctl","restart","mongod"]
