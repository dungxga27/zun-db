# Development API configuration. Copy to apps/api/.env for local use.
NODE_ENV=development
PORT=3001
METADATA_MONGODB_URI=mongodb://platform_admin:change-me@127.0.0.1:27017/zun_metadata?authSource=admin
MONGO_ADMIN_URI=mongodb://platform_admin:change-me@127.0.0.1:27017/admin?authSource=admin
PROJECT_MONGODB_HOST=127.0.0.1
PROJECT_MONGODB_PORT=27017
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
BACKUP_DIR=./data/backups
MONGODUMP_BIN=mongodump
MONGORESTORE_BIN=mongorestore

# Browser-visible web setting. Keep /api for same-origin deployments.
NEXT_PUBLIC_API_BASE_URL=/api

# Production installer inputs (examples only; do not store real passwords here).
DOMAIN=db.example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ENABLE_HTTPS=true
EXPOSE_MONGODB=false
MONGODB_ALLOWED_CIDR=203.0.113.10/32
ENABLE_BACKUPS=true
BACKUP_RETENTION_DAYS=14
PLATFORM_REPO_URL=https://github.com/your-org/your-repo.git
NONINTERACTIVE=true
